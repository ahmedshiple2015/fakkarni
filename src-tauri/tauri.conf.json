{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fakkarni",
  "version": "0.1.0",
  "identifier": "org.fakkarni.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 run dev",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Fakkarni · فكرني", "visible": false, "width": 1180, "height": 780, "minWidth": 860, "minHeight": 620 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
